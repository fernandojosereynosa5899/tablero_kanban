# Referencia de variables de entorno del proyecto.
# El archivo real con credenciales va en server/.env (ignorado por git). NUNCA lo commitees.
# Copia server/.env.example a server/.env y reemplaza cada marcador <...>.
DATABASE_URL="<CADENA_CONEXION_POSTGRESQL_CON_SSL>"
JWT_SECRET="<SECRETO_HEX_ALEATORIO_MIN_64_CHARS>"
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Contraseña inicial del equipo (solo usada si la BD está vacía o al sincronizar cuentas localmente)
SEED_INITIAL_PASSWORD="<CLAVE_INICIAL_DEL_EQUIPO>"

# Correo automático para notificaciones de archivos adjuntos (Gmail SMTP con contraseña de aplicación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="<TU_CORREO_GMAIL>"
SMTP_PASS="<CLAVE_DE_APLICACION_GMAIL>"
MAIL_NOTIFY_TO="<CORREO_DESTINO_NOTIFICACIONES>"

# Cuota global reservada para archivos adjuntos en PostgreSQL (MB) para proteger el límite de 1 GB
ATTACHMENTS_QUOTA_MB=512
