# Ejemplo de variables de entorno. Copia este archivo a server/.env y reemplaza cada marcador <...>.
# El archivo real con credenciales va en server/.env (ignorado por git). NUNCA lo commitees.
DATABASE_URL="<CADENA_CONEXION_POSTGRESQL_CON_SSL>"
# Genera JWT_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<SECRETO_HEX_ALEATORIO_MIN_64_CHARS>"
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Contraseña inicial del equipo (solo usada al inicializar una BD vacía o ejecutar scripts de prueba)
SEED_INITIAL_PASSWORD="<CLAVE_INICIAL_DEL_EQUIPO>"

# Google Drive privado + Gmail REST API sobre HTTPS 443 (recomendado en Render Free).
# Genera el refresh token localmente con: npm --prefix server run google:auth
GOOGLE_CLIENT_ID="<TU_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<TU_CLIENT_SECRET>"
GOOGLE_REFRESH_TOKEN="<TU_REFRESH_TOKEN>"
GOOGLE_DRIVE_ROOT_FOLDER="Tablero Kanban"

# Correo automático para notificaciones de archivos adjuntos:
# - MAIL_NOTIFY_TO define el correo destino tanto en Gmail REST API como en SMTP.
# - SMTP_* funciona como respaldo local cuando no se configura Google OAuth 2.0.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="<TU_CORREO_GMAIL>"
SMTP_PASS="<CLAVE_DE_APLICACION_GMAIL>"
MAIL_NOTIFY_TO="<CORREO_DESTINO_NOTIFICACIONES>"

# Cuota global reservada para archivos adjuntos en PostgreSQL (MB) para proteger el límite de 1 GB
ATTACHMENTS_QUOTA_MB=512

# Ventana de mantenimiento global (precedencia: MAINTENANCE_MODE=true > maintenance.json > control en vivo en BD)
MAINTENANCE_MODE="false"
# Personalización opcional cuando MAINTENANCE_MODE="true" (dejar vacío o comentado para usar textos por defecto):
# MAINTENANCE_TITLE=""
# MAINTENANCE_MESSAGE=""
# MAINTENANCE_ETA_MINUTES=""
